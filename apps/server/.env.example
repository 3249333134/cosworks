NODE_ENV=development
HOST=0.0.0.0
PORT=5000
PUBLIC_ORIGIN=http://localhost:5173
DATA_MODE=memory
DEPENDENCY_CHECK_STRICT=false

DB_HOST=mysql-server
DB_PORT=3306
DB_NAME=cosworks
DB_USER=cosworks_app
DB_PASSWORD=

REDIS_HOST=redis-server
REDIS_PORT=6379
REDIS_ENABLED=false
REDIS_DB=0
REDIS_USERNAME=cosworks_app
REDIS_PASSWORD=

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

AI_PROVIDER=local
AI_API_URL=https://apihub.agnes-ai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=agnes-2.5-flash
AI_TIMEOUT_MS=45000
AGNES_API_KEY=
AI_RPM=15
AI_CONCURRENCY=2

ADMIN_ALLOWLIST_CIDR=
LOG_LEVEL=info
